{
  "name": "habit-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "run-p type-check build-only build-server",
    "build-only": "vite build",
    "build-server": "tsc -p server/tsconfig.json",
    "start": "prisma migrate deploy && node dist-server/index.js",
    "preview": "vite preview",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ server/",
    "prebuild": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pinia": "^4.0.3",
    "prisma": "^7.10.0",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}
