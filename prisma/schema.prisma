generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int       @id @default(autoincrement())
  // Stored lowercase; usernames are case-insensitive
  username     String    @unique
  // Argon2id, as a PHC string. Null until a password is set: the owner from before accounts
  // existed starts that way (see server/legacy.ts).
  passwordHash String?
  createdAt    DateTime  @default(now())
  habits       Habit[]
  sessions     Session[]
}

model Session {
  // SHA-256 of the token in the cookie, so a copy of the database can't be used to log in
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Habit {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  emoji       String   @default("✨")
  color       String   @default("violet")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  tracks      Track[]

  @@index([userId])
}

model Track {
  id      Int      @id @default(autoincrement())
  habitId Int
  date    DateTime @default(now())
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, date])
}
